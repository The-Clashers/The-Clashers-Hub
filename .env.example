# .env.example
#
# Server-side-only environment variables for local development. Copy this
# file to `.env` and fill in the real values; `.env` is gitignored.
# CI never needs either value (tests run on fixtures); the Vercel project
# environment holds the production values.
#
# The browser bundle must never contain the key. The CI key-absence scan
# (scripts/scan-bundle-secrets.mjs) verifies this on every PR; see
# docs/concept/04-api-strategy section 7 and NFR-04.

# The Clash of Clans developer API key, generated from the team's designated
# game account. Optional for local dev: leave it empty to point the tier at
# the mock upstream (scripts/mock-upstream.mjs) instead.
COC_API_TOKEN=

# The RoyaleAPI community proxy base URL. The default below is the standard
# public proxy; only change it if you have a reason.
COC_API_BASE_URL=https://cocproxy.royaleapi.dev/v1
