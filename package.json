  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "react-native": "^0.88.0",
    "react-router": "^7.18.4",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
